FROM alpine:3.20 AS fonts-builder

RUN apk add --no-cache wget bash tar ca-certificates fontconfig

COPY app/fonts/install_fonts.sh /tmp/install_fonts.sh

RUN chmod +x /tmp/install_fonts.sh && \
    bash /tmp/install_fonts.sh && \
    ls -la /usr/local/share/fonts && \
    test -n "$(ls -A /usr/local/share/fonts)"

FROM node:20-alpine

RUN apk add --no-cache curl bash git fontconfig

WORKDIR /app

RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:$PATH"

COPY app/package.json app/bun.lock ./
RUN bun install

COPY app/ .
COPY .git ./.git

COPY --from=fonts-builder /usr/local/share/fonts /usr/local/share/fonts
RUN fc-cache -f

EXPOSE 3000
