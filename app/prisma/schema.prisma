generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------
// Model Table
// ----------------

model User {
  id            String              @id @default(uuid()) @db.Uuid
  email         String              @unique @db.VarChar(60)
  emailVerified DateTime?
  name          String?
  storageQuota  Int                 @default(10485760)

  accounts      Account[]
  sessions      Session[]
  projectLinks  ProjectAssignment[]

  @@map("users")
}

model Project {
  id        String              @id @default(uuid()) @db.Uuid
  title     String              @db.VarChar(60)
  fileTree  Json                @map("file_tree")
  isActive  Boolean             @default(true)

  thumbnail ProjectThumbnail?
  userLinks ProjectAssignment[]
  tags      ProjectTag[]

  @@map("projects")
}

model ProjectThumbnail {
  projectId String   @id @map("project_id") @db.Uuid
  data      Bytes
  mimeType  String   @default("image/png") @map("mime_type")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_thumbnails")
}

model Tag {
  id       String        @id @default(uuid()) @db.Uuid
  name     String        @unique @db.VarChar(50)
  projects ProjectTag[]

  @@map("tags")
}

// ----------------
// Auth.js Tables
// ----------------

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ----------------
// Relation Table
// ----------------

model ProjectAssignment {
  userId    String  @map("user_id") @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  role      String  @default("owner") // "owner" ou "editor"

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("project_assignments")
}

model ProjectTag {
  projectId String @map("project_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
  @@map("project_tags")
}